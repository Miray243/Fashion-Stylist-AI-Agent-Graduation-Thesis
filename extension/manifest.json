{
  "manifest_version": 3,
  "name": "Fashion Stylist AI",
  "version": "1.0",
  "description": "Analyzes fashion products and sends them to AI stylist.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.trendyol.com/*",
    "https://apigw.trendyol.com/*",
    "https://*.hepsiburada.com/*",
    "https://*.amazon.com.tr/*",
    "https://*.n11.com/*",
    "https://*.boyner.com.tr/*",
    "https://*.zara.com/*",
    "https://*.mango.com/*",
    "https://*.lcwaikiki.com/*",
    "https://*.koton.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.trendyol.com/*",
        "https://*.hepsiburada.com/*",
        "https://*.amazon.com.tr/*",
        "https://*.n11.com/*",
        "https://*.boyner.com.tr/*",
        "https://*.zara.com/*",
        "https://*.mango.com/*",
        "https://*.lcwaikiki.com/*",
        "https://*.koton.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}